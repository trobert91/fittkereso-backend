{
  "name": "@fittkereso-backend/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:api": "nx run api:serve",
    "start:products": "nx run product-collector:serve",
    "build:mcp": "nx run mcp:build",
    "start:mcp": "nx run mcp:serve --skip-nx-cache",
    "start:benchmark": "nx run benchmark:run --",
    "bench": "nx build benchmark && node dist/apps/benchmark/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "nx run-many -t test",
    "typeorm": "ts-node --project apps/api/tsconfig.app.json -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "typeorm:create": "npm run typeorm migration:create ./libs/config/src/lib/migrations/migration",
    "typeorm:generate": "npm run typeorm migration:generate ./libs/config/src/lib/migrations/migration -- -d ./apps/api/typeorm.config.ts",
    "typeorm:migrate": "cd ./apps/api && npm run typeorm migration:run -- -d ./apps/api/typeorm.config.ts && cd ../..",
    "typeorm:revert": "cd ./apps/api && npm run typeorm migration:revert -- -d ./apps/api/typeorm.config.ts && cd ../.."
  },
  "private": true,
  "dependencies": {
