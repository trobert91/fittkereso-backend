meta {
  name: Submit Contact Form
  type: http
  seq: 1
}

post {
  url: http://localhost:8088/api/v1/public/contact
  body: json
  auth: inherit
}

body:json {
  {
    "name": "John Doe",
    "email": "john@example.com",
    "message": "Hello, I have a question about your service.",
    "recaptchaToken": "test-token"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
