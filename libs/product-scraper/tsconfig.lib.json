{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "types": ["node"],
    "target": "es2021",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "../product/src/lib/services/product-spec/product-spec-sort.service.ts", "../product/src/lib/services/product-spec/product-spec-merge.service.ts", "../product/src/lib/services/image/product-image-copy.service.ts", "../product/src/lib/services/product-spec/product-spec-updater.service.ts", "../product/src/lib/models/product-link.ts", "../product/src/lib/models/scraped-product.ts", "../product/src/lib/models/spec-mapping.ts"],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
