  "category": {
    "labelFrom": [
      {
        "op": "regexCapture",
        "pattern": "^(Elektromos kerékpárok > Új E-bike Kerékpár|Cube kerékpárok)(?: > |$)",
        "group": 1
      }
    ]
  },
  "mapping": {
    "externalId": {
      "field": "identifier"
    },
    "brand": {
      "field": "manufacturer"
    },
    "name": {
      "field": "name"
    },
    "url": {
      "field": "product_url"
    },
    "price": {
      "field": "price"
    },
    "currency": {
      "pipeline": [
        {
          "op": "literal",
          "value": "HUF"
        }
      ]
    },
    "availability": {
      "field": "delivery_time",
      "pipeline": [
        {
          "op": "mapValue",
          "cases": {
            "NO": "out_of_stock"
          },
          "default": "in_stock"
        }
      ]
    },
    "imageUrl": {
      "field": "image_url"
    },
    "description": {
      "field": "description"
    },
    "categoryLabel": {
      "field": "category"
    },
    "releaseYear": [
      {
        "field": "name",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "\\b(20[2-3]\\d)\\b",
            "group": 1
          }
        ]
      },
      {
        "field": "product_url",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "-(20[2-3]\\d)(?:-|$|\\?)",
            "group": 1
          }
        ]
      }
    ],
    "gtin": {
      "field": "ean_code"
    },
    "mpn": {
      "field": "identifier",
      "pipeline": [
        {
          "op": "regexCapture",
          "pattern": "^VLB_(\\d{6,7}-(?:\\d{2}|XX?S|S|M|L|XX?L))(?:cm|[TE])?$",
          "group": 1
        }
      ]
    }
  },
  "postProcess": {
    "identityDescription": {
      "mode": "evidence"
    }
  }
}
