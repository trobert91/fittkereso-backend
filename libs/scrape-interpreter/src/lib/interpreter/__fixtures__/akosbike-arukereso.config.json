{
  "baseUrl": "https://akosbike.hu",
  "feedUrl": "https://akosbike.hu/api/?route=export/feed&id=arukereso",
  "format": "auto",
  "categories": {
    "ebikes": {
      "enabled": true,
      "rules": [
        {
          "when": {
            "equalsIgnoreCase": "Elektromos kerékpárok > Új E-bike Kerékpár"
          },
          "unless": {
            "specValueIncludes": {
              "label": "Állapot",
              "anyOf": [
                "használt",
                "bemutató",
                "futott",
                "újszerű"
              ]
            }
          }
        }
      ],
      "specMapping": {
        "mappings": [
          {
            "key": "frameType",
            "labels": [
              "Kialakítás",
              "Vázméret"
            ],
            "valueMap": {
              "XS": "Magas",
              "S": "Magas",
              "M": "Magas",
              "L": "Magas",
              "XL": "Magas",
              "XXL": "Magas",
              "S, M, L, XL": "Magas",
              "50 cm": "Magas",
              "54 cm": "Magas",
              "58 cm": "Magas",
              "62 cm": "Magas",
              "64 cm": "Magas",
              "50 cm / S": "Magas",
              "58 cm / L": "Magas",
              "50 cm/S, alacsony-átlagos testmagasságnak megfelelő": "Magas"
            },
            "trimSuffixes": [
              "\\d.*",
              "\\s(?:XXL|XL|XS|S|M|L)"
            ],
            "replacePatterns": [
              {
                "from": "Easy Entry",
                "to": "Alacsony"
              },
              {
                "from": "Trapeze",
                "to": "Trapéz"
              }
            ]
          },
          {
            "key": "frameType",
            "labels": [
              "Váz kialakítás"
            ],
            "valuePatterns": [
              {
                "pattern": "trap",
                "value": "Trapéz"
              }
            ]
          },
          {
            "key": "frameType",
            "labels": [
              "Váz kialakítás"
            ],
            "valuePatterns": [
              {
                "pattern": "easy entry|alacsony",
                "value": "Alacsony"
              }
            ]
          },
          {
            "key": "frameSize",
            "labels": [
              "Vázméret"
            ],
            "extract": "regexpList",
            "extractPatterns": [
              "^(?:(?:Easy Entry|Trapeze)\\s+)?(\\d+(?:[.,]\\d+)?)\\s*cm"
            ]
          },
          {
            "key": "frameSizeLabel",
            "labels": [
              "Vázméret"
            ],
            "extract": "regexpList",
            "extractPatterns": [
              "^(?:(?:Easy Entry|Trapeze)\\s+)?(?:\\d+\\s*cm\\s*/\\s*)?(XXL|XL|XS|S|M|L)\\b(?!\\s*,\\s*(?:XXL|XL|XS|S|M|L)\\b)"
            ]
          },
          {
            "key": "wheelSize",
            "labels": [
              "Webshop kategória"
            ],
            "extract": "regexpList",
            "extractPatterns": [
              "^Cube kerékpárok > (\\d{2})\" gyerek"
            ]
          },
          {
            "key": "recommendedRiderHeight",
            "labels": [
              "Ajánlott magasság",
              "Ajánlott gyártói magasság"
            ],
            "extract": "regexpList",
            "extractPatterns": [
              "^((?:kb\\.\\s*)?\\d{2,3}\\s*-\\s*\\d{2,3}\\s*cm)"
            ]
          },
          {
            "key": "standoverHeight",
            "labels": [
              "Ajánlott gyártói magasság"
            ],
            "extract": "regexpList",
            "extractPatterns": [
              "átlépési magasság\\s*:\\s*(\\d{2,3}\\s*-\\s*\\d{2,3}\\s*cm)"
            ]
          },
          {
            "key": "standoverHeight",
            "labels": [
              "Átlépési magasság"
            ],
            "skipValues": [
              "-",
              "–",
              "n/a",
              "na",
              "no",
              "none",
              "nincs",
              "0",
              "tbd",
              "#tbd"
            ]
          },
          {
            "key": "color",
            "labels": [
              "Szín"
            ],
            "skipValues": [
              "-",
              "–",
              "n/a",
              "na",
              "no",
              "none",
              "nincs",
              "0",
              "tbd",
              "#tbd"
            ]
          },
