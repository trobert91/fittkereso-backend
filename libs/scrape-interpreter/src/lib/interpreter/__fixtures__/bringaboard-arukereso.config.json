  "mapping": {
    "externalId": {
      "field": "identifier"
    },
    "brand": {
      "field": "manufacturer",
      "pipeline": [
        {
          "op": "stripPattern",
          "pattern": "\\s+kerékpár$",
          "flags": "i"
        }
      ]
    },
    "name": {
      "field": "name"
    },
    "url": {
      "field": "product_url",
      "pipeline": [
        {
          "op": "stripPattern",
          "pattern": "\\?.*$"
        }
      ]
    },
    "price": {
      "field": "price"
    },
    "availability": {
      "field": "delivery_time",
      "pipeline": [
        {
          "op": "mapValue",
          "cases": {
            "NO": "out_of_stock"
          },
          "default": "in_stock"
        }
      ]
    },
    "imageUrl": {
      "field": "image_url"
    },
    "description": {
      "field": "description"
    },
    "categoryLabel": {
      "field": "category"
    },
    "currency": {
      "pipeline": [
        {
          "op": "literal",
          "value": "HUF"
        }
      ]
    },
    "gtin": [
      {
        "field": "ean_code"
      },
      {
        "field": "sku",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "^(\\d{13})$",
            "group": 1
          }
        ]
      }
    ],
    "mpn": {
      "field": "sku",
      "pipeline": [
        {
          "op": "regexCapture",
          "pattern": "^(?:ktm-)?([125]\\d{9})$",
          "group": 1
        }
      ]
    }
  },
  "specMapping": {
    "ebikes": {
      "mappings": [
        {
          "key": "modelYear",
          "labels": ["Évjárat", "Model year"],
          "extract": "number"
        },
        {
          "key": "batteryCapacity",
          "labels": [
            "Akkukapacitás",
            "Battery Capacity",
            "KAPACITÁS",
            "teljesítménye",
            "BATTERY",
            "Akkumulátor",
            "Akku",
            "AKKU/BATTERY"
          ],
          "extract": "regexpList",
          "extractPatterns": ["(\\d{3,4})\\s*Wh"]
        },
        {
          "key": "wheelSize",
          "labels": ["Kerékméret", "WHEELSIZE", "Kerék átmérő", "Wheel size", "Kerékméret (\")"],
          "replacePatterns": [
            { "from": ",", "to": "." },
            { "from": "700C", "to": "28" },
            { "from": "700c", "to": "28" }
          ],
          "extract": "number"
        },
        {
          "key": "torque",
          "labels": [
            "Max. nyomaték",
            "Drive Unit",
            "Engine",
            "Type of Motor",
            "Meghajtó egység",
            "MOTOR CAPACITY",
            "Motor típus",
            "Motor"
          ],
          "extract": "regexpList",
          "extractPatterns": ["(\\d{2,3})\\s*Nm"]
        },
        {
          "key": "motorPower",
          "labels": [
            "Motor névleges teljesítménye",
            "Drive Unit",
            "Engine",
            "Type of Motor",
            "Meghajtó egység",
            "MOTOR CAPACITY",
            "Motor"
          ],
          "extract": "regexpList",
          "extractPatterns": ["(\\d{3})\\s*W(?!h)"]
        },
        {
          "key": "topSpeed",
          "labels": ["Rásegítéssel elérhető sebesség", "Drive Unit", "Type of Motor", "Engine", "Motor"],
          "extract": "regexpList",
          "extractPatterns": ["(\\d{2})\\s*km\\s*/\\s*h"]
        },
        {
          "key": "weight",
          "labels": [
            "WEIGHT",
            "Súly",
            "Tömeg",
            "Approx weight in KG",
            "Approx weights in KG",
            "Teljes súly",
            "Net weight"
          ],
          "skipValues": ["tbd", "0"],
          "replacePatterns": [{ "from": ",", "to": "." }],
          "extract": "number"
        },
        {
          "key": "frameMaterial",
          "labels": ["Anyag", "Vázanyag", "VÁZ ANYAGA"],
          "valueMap": {
            "hliník": "Alumínium",
            "aluminium": "Alumínium",
            "alumínium": "Alumínium",
            "alumínium ötvözet": "Alumínium",
            "alimínium": "Alumínium",
