{
  "baseUrl": "https://www.bringaboard.hu",
  "feedUrl": "https://www.bringaboard.hu/api/?route=export/feed&id=arukereso",
  "format": "auto",
  "categories": {
    "ebikes": {
      "enabled": true,
      "sourceTitle": "E-BIKE"
    }
  },
  "category": {
    "labelFrom": [
      {
        "op": "regexCapture",
        "pattern": "^(E-BIKE(?! > E-ROLLER\\b)|Kerékpár > E-Bike kerékpárok)(?: > |$)",
        "group": 1
      }
    ],
    "slugLookup": [
      {
        "when": {
          "equalsIgnoreCase": "E-BIKE"
        },
        "slug": "ebikes"
      },
      {
        "when": {
          "equalsIgnoreCase": "Kerékpár > E-Bike kerékpárok"
        },
        "unless": {
          "specValueIncludes": {
            "label": "Cassette / freewheel",
            "anyOf": ["SINGLE"]
          }
        },
        "slug": "ebikes"
      }
    ]
  },
