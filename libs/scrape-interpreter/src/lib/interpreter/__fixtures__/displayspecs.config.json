{
  "baseUrl": "https://www.displayspecifications.com",
  "fullSyncStartUrl": "https://www.displayspecifications.com",

  "discovery": {
    "mode": "brandNameMatch",
    "linkPipeline": [
      {
        "op": "selectFirst",
        "selector": ".brand-listing-container-frontpage",
        "as": "brandDiv",
        "onMissing": "throw"
      },
      { "op": "selectAll", "selector": "a", "within": "brandDiv" },
      {
        "op": "extractLinkTitlePairs",
        "resolveRelativeAgainst": "baseUrl"
      },
      {
        "op": "matchAgainstRuntimeList",
        "source": "runtime:brandNames",
        "field": "title",
        "caseInsensitive": true
      }
    ]
  },

  "categories": {
    "monitors": { "enabled": true },
    "tvs": { "enabled": true }
  },

  "incrementalSync": {
    "searchKeywords": ["monitor specs", "tv specifications"],
    "numResults": 20,
    "urlClassify": {
      "detailUrlPattern": "displayspecifications\\.com\\/\\w+\\/model\\/\\w+\\/"
    }
  },

  "listPage": {
    "categoryName": [],
    "categoryLinks": [],
    "productLinks": [
      { "op": "selectAll", "selector": "header.section-header", "as": "headers" },
      { "op": "selectText", "selector": "h1.header", "trim": true, "as": "category" },
      { "op": "filterByNonEmpty", "value": "category", "onFail": "returnEmpty" },
      { "op": "splitAndTake", "value": "category", "separator": "-", "index": 0, "trim": true, "as": "brand" },
      {
        "op": "selectSiblingContainer",
        "on": "headers",
        "untilSelector": "header.section-header",
        "filterSelector": ".model-listing-container-80",
        "first": true,
        "as": "container"
      },
      { "op": "selectAll", "on": "container", "selector": "div[id^=\"model_\"]", "as": "modelDivs" },
      {
        "op": "extractLinkFromBox",
        "on": "modelDivs",
        "linkSelector": "h3 a",
        "titleTransform": [
          { "op": "splitAndSlice", "separator": " ", "skipFirst": 1 }
        ],
        "titleTemplate": "{{brand}} {{title}}",
        "categoryFrom": "category"
      },
      { "op": "filterByCategoryYearSuffix", "yearsBack": 2, "includeCurrentYear": true }
    ]
  },

  "detailPage": {
    "rawSpecs": [
      { "op": "selectAll", "selector": "header.section-header", "as": "sections" },
      {
        "op": "extractSpecTableBySection",
        "on": "sections",
        "sectionTitleSelector": "h2.header",
        "tableSelector": "table.model-information-table",
        "tableRelation": "nextAll",
        "tableFirst": true,
        "rowSelector": "tbody > tr",
        "minCells": 2,
        "nameCellIndex": 0,
        "nameExcludeChildren": "p",
        "descriptionCellIndex": 0,
        "descriptionSelector": "p",
        "valueCellIndex": 1,
        "splitValueOn": "<br\\s*/?>",
        "htmlAware": true
      }
    ],

    "category": {
      "breadcrumbOrSource": [],
      "slugLookup": [
        {
          "when": { "specSectionTitleIn": ["Video file formats", "Audio file formats", "TV tuner"] },
          "slug": "tvs"
        },
        { "when": { "always": true }, "slug": "monitors" }
      ]
    },

    "brand": [{ "op": "mapSpecValue", "label": "Brand", "single": true }],
    "model": [{ "op": "mapSpecValue", "label": "Model", "single": true }],
    "aliases": [
      { "op": "mapSpecValue", "label": "Model alias", "single": false },
      { "op": "filterOutEqualsIgnoreCase", "against": "model" },
      { "op": "dedupe" }
    ],
    "releaseYear": [
      { "op": "mapSpecValue", "label": "Model year", "single": true, "cast": "number" }
    ],
    "images": [],

    "specMapping": {
      "monitors": {
        "mappings": [
          { "key": "screenSize", "labels": ["Size class"] },
          {
            "key": "resolution",
            "labels": ["Resolution"],
            "extract": "removeWhitespace",
            "trimSuffixes": ["pixels"],
            "replacePatterns": [{ "from": "×", "to": "x" }]
          },
          { "key": "aspectRatio", "labels": ["Aspect ratio"], "extract": "standardRatio" },
          { "key": "curvature", "labels": ["Radius of curvature"], "extract": "ceiledNumber" },
          { "key": "panelType", "labels": ["Panel Type"] },
          { "key": "panelBitDepth", "labels": ["Panel bit depth"] },
          { "key": "refreshRate", "labels": ["Vertical frequency (digital)"], "extract": "secondNumber" },
          { "key": "responseTime", "labels": ["Minimum response time"], "extract": "number" },
          { "key": "brightness", "labels": ["Brightness"], "extract": "number" },
          { "key": "peakBrightness", "labels": ["Peak brightness"], "extract": "number" },
          {
            "key": "contrastRatio",
            "labels": ["Static contrast"],
            "extract": "removeWhitespace",
            "replacePatterns": [{ "from": "~", "to": "" }]
          },
          { "key": "viewingAngle", "labels": ["Horizontal viewing angle"], "extract": "number" },
          { "key": "coating", "labels": ["Coating"] },
          { "key": "vesaMount", "labels": ["VESA interface"], "extract": "list" },
          { "key": "hdmiCount", "labels": ["HDMI ports"], "extract": "number" },
          { "key": "usbCount", "labels": ["USB ports"], "extract": "number" },
          { "key": "connections", "labels": ["Connectivity"], "extract": "shuffledList" },
          { "key": "speakers", "labels": ["Speakers"] },
          { "key": "hdr", "labels": ["HDR"], "extract": "list" },
          { "key": "pixelDensity", "labels": ["Pixel density"], "extract": "number" },
          { "key": "heightAdjustment", "labels": ["Height adjustment"] },
          { "key": "weightWithStand", "labels": ["Weight with stand"], "extract": "number" },
          { "key": "weightWithoutStand", "labels": ["Weight"], "extract": "number" },
          { "key": "3d", "labels": ["3D"] },
          { "key": "powerConsumption", "labels": ["Power consumption (average)"], "extract": "number" },
          { "key": "backlight", "labels": ["Backlight"] },
          { "key": "colorGamutSrgb", "labels": ["sRGB"], "extract": "number" },
          { "key": "colorGamutDciP3", "labels": ["DCI P3"], "extract": "number" },
          { "key": "inputLag", "labels": ["Input lag"], "extract": "number" },
          { "key": "frc", "labels": ["FRC"] },
          { "key": "portraitPivot", "labels": ["Landscape/portrait pivot"] },
          { "key": "energyClass", "labels": ["Energy efficiency class"] },
          { "key": "swivel", "labels": ["Left/right swivel"] },
          { "key": "tiltable", "labels": ["Forward/backward tilt"] },
          {
            "key": "widthWithStand",
            "labels": ["Width with stand"],
            "sectionTitle": "Dimensions, weight and color",
            "extract": "regexpList",
            "extractPatterns": ["([\\d.]+)\\s*(cm)", "([\\d.]+)\\s*(in)"]
          },
          {
            "key": "heightWithStand",
            "labels": ["Height with stand"],
            "sectionTitle": "Dimensions, weight and color",
            "extract": "regexpList",
            "extractPatterns": ["([\\d.]+)\\s*(cm)", "([\\d.]+)\\s*(in)"]
          },
          {
            "key": "depthWithStand",
            "labels": ["Depth with stand"],
            "sectionTitle": "Dimensions, weight and color",
            "extract": "regexpList",
            "extractPatterns": ["([\\d.]+)\\s*(cm)", "([\\d.]+)\\s*(in)"]
          },
          {
            "key": "widthWithoutStand",
            "labels": ["Width"],
            "sectionTitle": "Dimensions, weight and color",
            "extract": "regexpList",
            "extractPatterns": ["([\\d.]+)\\s*(cm)", "([\\d.]+)\\s*(in)"]
          },
          {
            "key": "heightWithoutStand",
            "labels": ["Height"],
            "sectionTitle": "Dimensions, weight and color",
            "extract": "regexpList",
            "extractPatterns": ["([\\d.]+)\\s*(cm)", "([\\d.]+)\\s*(in)"]
          },
          {
            "key": "depthWithoutStand",
            "labels": ["Depth"],
            "sectionTitle": "Dimensions, weight and color",
            "extract": "regexpList",
            "extractPatterns": ["([\\d.]+)\\s*(cm)", "([\\d.]+)\\s*(in)"]
          }
        ],
        "calculated": [
          { "key": "isCurved", "rule": "presentIfKey", "source": "curvature" },
          { "key": "freesync", "rule": "featureSearch", "source": "Features", "keywords": ["freesync"] },
          { "key": "gsync", "rule": "featureSearch", "source": "Features", "keywords": ["g-sync", "gsync"] }
        ]
      }
    },

    "offers": {
      "listItems": [],
      "sellerName": [],
      "price": []
    },

    "translation": {
      "enabled": false,
      "sourceLanguage": "en",
      "targetLanguage": "en",
      "contextTemplate": ""
    }
  }
}
