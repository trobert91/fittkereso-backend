{
  "baseUrl": "https://www.ambringa.hu",
  "feedUrl": "https://www.ambringa.hu/api/?route=export/feed&id=argep",
  "format": "auto",
  "categories": {
    "ebikes": {
      "enabled": true,
      "rules": [
        {
          "when": {
            "equalsIgnoreCase": "Elektromos kerékpár"
          }
        },
        {
          "when": {
            "equalsIgnoreCase": "Akciók és ajánlatok > Akciós ebike modellek"
          }
        }
      ]
    }
  },
  "mapping": {
    "externalId": {
      "field": "sku"
    },
    "brand": {
      "field": "manufacturer",
      "pipeline": [
        {
          "op": "stripPattern",
          "pattern": "\\s+Bike$",
          "flags": "i"
        }
      ]
    },
    "name": {
      "field": "name"
    },
    "url": {
      "field": "product_url"
    },
    "price": {
      "field": "price"
    },
    "currency": {
      "pipeline": [
        {
          "op": "literal",
          "value": "HUF"
        }
      ]
    },
    "imageUrl": {
      "field": "image_url"
    },
    "description": {
      "field": "description"
    },
    "categoryLabel": {
      "field": "category"
    },
    "gtin": {
      "field": "gtin"
    },
    "mpn": [
      {
        "field": "manufacturer_partnumber",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "^(\\d{6,7}-(?:\\d{2}|XX?S|S|M|L|XX?L))(?:cm|[TE])?$",
            "group": 1
          }
        ]
      },
      {
        "field": "manufacturer_partnumber",
        "pipeline": [
          {
            "op": "stripPattern",
            "pattern": "^(\\d{2}(-\\d{2})?-[A-Z]{1,3}|\\d{13})$"
          }
        ]
      }
    ]
  }
}
