{
  "baseUrl": "https://www.ambringa.hu",
  "feedUrl": "https://www.ambringa.hu/api/?route=export/feed&id=argep",
  "format": "auto",
  "categories": {
    "ebikes": {
      "enabled": true,
      "rules": [
        {
          "when": {
            "equalsIgnoreCase": "Elektromos kerékpár"
          }
        },
        {
          "when": {
            "equalsIgnoreCase": "Akciók és ajánlatok > Akciós ebike modellek"
          }
        }
      ],
      "specMapping": {
        "mappings": [
          {
            "key": "frameType",
            "labels": [
              "Váz kialakítás"
            ],
            "valuePatterns": [
              {
                "pattern": "^Magas$",
                "value": "Magas"
              },
              {
                "pattern": "^Trapéz$",
                "value": "Trapéz"
              },
              {
                "pattern": "^Alacsony$",
                "value": "Alacsony"
              }
            ]
          }
        ]
      },
      "extraSpecRows": [
        {
          "label": "Váz kialakítás",
          "field": "sku",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "_(df|tf|cf)$",
              "group": 1
            },
            {
              "op": "mapValue",
              "cases": {
                "df": "Magas",
                "tf": "Trapéz",
                "cf": "Alacsony"
              }
            }
          ]
        },
        {
          "label": "Webshop kategória",
          "field": "sku",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "_(fs|fo)$",
              "group": 1
            },
            {
              "op": "mapValue",
              "cases": {
                "fs": "Összteleszkópos MTB",
                "fo": "Összecsukható"
              }
            }
          ]
        },
        {
          "label": "Motor névleges teljesítménye",
          "field": "description",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "<em>Nominális motor teljesítmény:\\s*</em>\\s*([^<]+?)\\s*<",
              "group": 1
            }
          ]
        },
        {
          "label": "Rásegítés sebességhatára",
          "field": "description",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "<em>Elektromos rásegítés sebesség-limitje:\\s*</em>\\s*([^<]+?)\\s*<",
              "group": 1
            }
          ]
        },
        {
          "label": "Motor működési elve",
          "field": "description",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "<em>Működési elv:\\s*</em>\\s*([^<]+?)\\s*<",
              "group": 1
            }
          ]
        },
        {
          "label": "Akkumulátor elhelyezése",
          "field": "description",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "<em>Elhelyezés a kerékpáron:\\s*</em>\\s*([^<]+?)\\s*<",
              "group": 1
            }
          ]
        },
        {
          "label": "Akkumulátor technológiája",
          "field": "description",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "<em>Technológia:\\s*</em>\\s*([^<]+?)\\s*<",
              "group": 1
            }
          ]
        },
        {
          "label": "Akkumulátor levehető",
          "field": "description",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "<em>Levehető az ebike-ról:\\s*</em>\\s*([^<]+?)\\s*<",
              "group": 1
            }
          ]
        }
      ]
    }
  },
  "mapping": {
    "externalId": {
      "field": "sku"
    },
    "brand": {
      "field": "manufacturer",
      "pipeline": [
        {
          "op": "stripPattern",
          "pattern": "\\s+Bike$",
          "flags": "i"
        }
      ]
    },
    "name": {
      "field": "name"
    },
    "url": {
      "field": "product_url"
    },
    "price": {
      "field": "price"
    },
    "currency": {
      "pipeline": [
        {
          "op": "literal",
          "value": "HUF"
        }
      ]
    },
    "imageUrl": {
      "field": "image_url"
    },
    "description": {
      "field": "description"
    },
    "categoryLabel": {
      "field": "category"
    },
    "gtin": {
      "field": "gtin"
    },
    "mpn": [
      {
        "field": "manufacturer_partnumber",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "^(\\d{6,7}-(?:\\d{2}|XX?S|S|M|L|XX?L))(?:cm|[TE])?$",
            "group": 1
          }
        ]
      },
      {
        "field": "manufacturer_partnumber",
        "pipeline": [
          {
            "op": "stripPattern",
            "pattern": "^(\\d{2}(-\\d{2})?-[A-Z]{1,3}|\\d{13})$"
          }
        ]
      }
    ]
  }
}
