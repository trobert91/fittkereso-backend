{
  "baseUrl": "https://www.ambringa.hu",
  "feedUrl": "https://www.ambringa.hu/api/?route=export/feed&id=argep",
  "format": "auto",
  "categories": {
    "ebikes": {
      "enabled": true,
      "rules": [
        {
          "when": {
            "equalsIgnoreCase": "Elektromos kerékpár"
          }
        },
        {
          "when": {
            "equalsIgnoreCase": "Akciók és ajánlatok > Akciós ebike modellek"
          }
        }
      ],
      "specMapping": {
        "mappings": [
          {
            "key": "frameType",
            "labels": [
              "Váz kialakítás"
            ],
            "valuePatterns": [
              {
                "pattern": "^Magas$",
                "value": "Magas"
              },
              {
                "pattern": "^Trapéz$",
                "value": "Trapéz"
              },
              {
                "pattern": "^Alacsony$",
                "value": "Alacsony"
              }
            ]
          },
          {
            "key": "batteryCapacity",
            "labels": [
              "Akkumulátor kapacitása (cím)"
            ],
            "extract": "number"
          },
          {
            "key": "motorPower",
            "labels": [
              "Motor névleges teljesítménye"
            ],
            "extract": "number"
          },
          {
            "key": "topSpeed",
            "labels": [
              "Rásegítés sebességhatára"
            ],
            "extract": "number"
          },
          {
            "key": "sensorType",
            "labels": [
              "Motor működési elve"
            ],
            "valuePatterns": [
              {
                "pattern": "nyomaték.*fordulatszám|fordulatszám.*nyomaték",
                "value": "Nyomaték- és fordulatszám-szenzor"
              },
              {
                "pattern": "nyomaték",
                "value": "Nyomatékszenzor"
              },
              {
                "pattern": "fordulatszám",
                "value": "Fordulatszám-szenzor"
              }
            ]
          },
          {
            "key": "batteryPosition",
            "labels": [
              "Akkumulátor elhelyezése"
            ],
            "valuePatterns": [
              {
                "pattern": "csomagtart",
                "value": "Csomagtartóra szerelt"
              },
              {
                "pattern": "vázra szerelt|külső|kívül",
                "value": "Külső"
              },
              {
                "pattern": "belsej|rejtett|integrált",
                "value": "Vázba integrált"
              }
            ]
          },
          {
            "key": "batteryChemistry",
            "labels": [
              "Akkumulátor technológiája"
            ],
            "valuePatterns": [
              {
                "pattern": "^li-?ion$",
                "value": "Li-ion"
              },
              {
                "pattern": "li-?pol",
                "value": "Li-polimer"
              }
            ]
          },
          {
            "key": "batteryRemovable",
            "labels": [
              "Akkumulátor levehető"
            ],
            "valuePatterns": [
              {
                "pattern": "^igen",
                "value": "true"
              },
              {
                "pattern": "^nem",
                "value": "false"
              }
            ]
          },
          {
            "key": "gender",
            "labels": [
              "Nem (cím)"
            ],
            "valuePatterns": [
              {
                "pattern": "^(férfi|men)$",
                "value": "Férfi"
              },
              {
                "pattern": "^(női|women)$",
                "value": "Női"
              },
              {
                "pattern": "^unisex$",
                "value": "Uniszex"
              }
            ]
          },
          {
            "key": "frameSize",
            "labels": [
              "Vázméret (cikkszám, cm)"
            ],
            "extract": "number"
          },
          {
            "key": "frameSizeLabel",
            "labels": [
              "Vázméret jelölés (cikkszám)"
            ],
            "valuePatterns": [
              {
                "pattern": "^XXL$",
                "value": "XXL"
              },
              {
                "pattern": "^XL$",
                "value": "XL"
              },
              {
                "pattern": "^XS$",
                "value": "XS"
              },
              {
                "pattern": "^S$",
                "value": "S"
              },
              {
                "pattern": "^M$",
                "value": "M"
              },
              {
                "pattern": "^L$",
                "value": "L"
              }
            ]
          }
        ]
      },
      "extraSpecRows": [
        {
          "label": "Váz kialakítás",
          "field": "sku",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "_(df|tf|cf)$",
              "group": 1
            },
            {
              "op": "mapValue",
              "cases": {
                "df": "Magas",
                "tf": "Trapéz",
                "cf": "Alacsony"
              }
            }
          ]
        },
        {
          "label": "Webshop kategória",
          "field": "sku",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "_(fs|fo)$",
              "group": 1
            },
            {
              "op": "mapValue",
              "cases": {
                "fs": "Összteleszkópos MTB",
                "fo": "Összecsukható"
              }
            }
          ]
        },
        {
          "label": "Motor névleges teljesítménye",
          "field": "description",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "<em>Nominális motor teljesítmény:\\s*</em>\\s*([^<]+?)\\s*<",
              "group": 1
            }
          ]
        },
        {
          "label": "Rásegítés sebességhatára",
          "field": "description",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "<em>Elektromos rásegítés sebesség-limitje:\\s*</em>\\s*([^<]+?)\\s*<",
              "group": 1
            }
          ]
        },
        {
          "label": "Motor működési elve",
          "field": "description",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "<em>Működési elv:\\s*</em>\\s*([^<]+?)\\s*<",
              "group": 1
            }
          ]
        },
        {
          "label": "Akkumulátor elhelyezése",
          "field": "description",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "<em>Elhelyezés a kerékpáron:\\s*</em>\\s*([^<]+?)\\s*<",
              "group": 1
            }
          ]
        },
        {
          "label": "Akkumulátor technológiája",
          "field": "description",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "<em>Technológia:\\s*</em>\\s*([^<]+?)\\s*<",
              "group": 1
            }
          ]
        },
        {
          "label": "Akkumulátor levehető",
          "field": "description",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "<em>Levehető az ebike-ról:\\s*</em>\\s*([^<]+?)\\s*<",
              "group": 1
            }
          ]
        },
        {
          "label": "Akkumulátor kapacitása (cím)",
          "field": "name",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "\\((\\d{3,4})\\s*Wh\\b",
              "group": 1
            }
          ]
        },
        {
          "label": "Nem (cím)",
          "field": "name",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "(?:^|[\\s(/,-])([Ff]érfi|FÉRFI|[Nn]ői|NŐI|[Uu]nisex|UNISEX|Men|Women)(?=$|[\\s),/-])",
              "group": 1
            }
          ]
        },
        {
          "label": "Vázméret (cikkszám, cm)",
          "field": "sku",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "^\\d{6,7}-(\\d{2})(?:cm|[TE])?_[a-z]{2}$",
              "group": 1
            }
          ]
        },
        {
          "label": "Vázméret jelölés (cikkszám)",
          "field": "sku",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "^\\d{6,7}-(XS|S|M|L|XL|XXL)_[a-z]{2}$",
              "group": 1
            }
          ]
        }
      ]
    }
  },
  "mapping": {
    "externalId": {
      "field": "sku"
    },
    "brand": {
      "field": "manufacturer",
      "pipeline": [
        {
          "op": "stripPattern",
          "pattern": "\\s+Bike$",
          "flags": "i"
        }
      ]
    },
    "name": {
      "field": "name"
    },
    "url": {
      "field": "product_url"
    },
    "price": {
      "field": "price"
    },
    "currency": {
      "pipeline": [
        {
          "op": "literal",
          "value": "HUF"
        }
      ]
    },
    "imageUrl": {
      "field": "image_url"
    },
    "description": {
      "field": "description"
    },
    "categoryLabel": {
      "field": "category"
    },
    "gtin": {
      "field": "gtin"
    },
    "mpn": [
      {
        "field": "manufacturer_partnumber",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "^(\\d{6,7}-(?:\\d{2}|XX?S|S|M|L|XX?L))(?:cm|[TE])?$",
            "group": 1
          }
        ]
      },
      {
        "field": "manufacturer_partnumber",
        "pipeline": [
          {
            "op": "stripPattern",
            "pattern": "^(\\d{2}(-\\d{2})?-[A-Z]{1,3}|\\d{13})$"
          }
        ]
      }
    ]
  }
}
