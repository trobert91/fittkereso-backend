{
  "baseUrl": "https://www.bikelife.hu",
  "feedUrl": "https://www.bikelife.hu/api/?route=export/feed&id=argep",
  "format": "auto",
  "categories": {
    "ebikes": {
      "enabled": true,
      "rules": [
        {
          "when": {
            "equalsIgnoreCase": "Pedelec kerékpárok"
          }
        }
      ]
    },
    "bikes": {
      "enabled": false,
      "extraSpecRows": [
        {
          "label": "Webshop kategória",
          "field": "sku",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "^(01\\d\\d)\\d{8}$",
              "group": 1
            },
            {
              "op": "mapValue",
              "cases": {
                "0100": "Futóbicikli",
                "0101": "Futóbicikli",
                "0102": "Gyerek",
                "0103": "BMX",
                "0104": "MTB 26\"",
                "0105": "Trekking",
                "0106": "Cross Trekking",
                "0107": "Fitness",
                "0108": "Országúti",
                "0109": "City",
                "0110": "Cruiser",
                "0112": "Tandem",
                "0120": "MTB 29\"",
                "0130": "MTB 27.5\"",
                "0140": "Cyclocross",
                "0150": "Gravel"
              }
            }
          ]
        }
      ]
    }
  },
  "mapping": {
    "externalId": {
      "field": "sku"
    },
    "brand": [
      {
        "field": "manufacturer"
      },
      {
        "field": "name",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "^(\\S+)",
            "group": 1
          }
        ]
      }
    ],
    "name": {
      "field": "name"
    },
    "url": {
      "field": "product_url"
    },
    "price": {
      "field": "price"
    },
    "currency": {
      "pipeline": [
        {
          "op": "literal",
          "value": "HUF"
        }
      ]
    },
    "availability": {
      "field": "SzállításiIdő",
      "pipeline": [
        {
          "op": "mapValue",
          "cases": {
            "NO": "out_of_stock"
          },
          "default": "in_stock"
        }
      ]
    },
    "imageUrl": {
      "field": "image_url"
    },
    "description": {
      "field": "description"
    },
    "categoryLabel": [
      {
        "field": "category",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "^(?!Kerékpárok(?: >|$))(.+)$",
            "group": 1
          }
        ]
      },
      {
        "field": "sku",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "^(0200)\\d{8}$",
            "group": 1
          },
          {
            "op": "mapValue",
            "cases": {
              "0200": "Pedelec kerékpárok"
            }
          }
        ]
      }
    ],
    "gtin": {
      "field": "gtin"
    },
    "mpn": {
      "field": "manufacturer_partnumber",
      "pipeline": [
        {
          "op": "regexCapture",
          "pattern": "^(\\d{9,10}|[Nn][Ee]\\d{10}|\\d{8}[A-Z][A-Z0-9]{1,2}|\\d{6}(?:-\\d{3})?)$",
          "group": 1
        }
      ]
    }
  },
  "postProcess": {
    "identityDescription": {
      "mode": "evidence"
    }
  }
}
