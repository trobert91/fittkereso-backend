          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "(?:^|[\\s,(])([Aa]lu|ALU|[Aa]lumínium|[Aa]luminium|[Aa]cél|[Kk]arbon|[Cc]arbon)(?:\\/Mg)?\\.?\\s?(?:mono)?(?:váz|VÁZ)",
              "group": 1
            }
          ]
        },
        {
          "label": "Kerékméret (cím)",
          "field": "name",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "(?:^|[\\s,(])(?<!\\/\\s?)((?:1[246]|18|2[0468]|27[,.]5|29)(?=[\"”]?-?(?:os|as|es)(?![a-zA-Záéíóöőúüű])|[\"”]?\\s?(?:kerék|MTB))|(?:27[,.]5|28|29)(?=[\"”](?!\\s?\\/)))",
              "group": 1
            }
          ]
        },
        {
          "label": "Rugózás (cím)",
