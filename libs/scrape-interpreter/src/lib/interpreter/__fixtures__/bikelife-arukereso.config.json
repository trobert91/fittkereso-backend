              "pattern": "(?:^|[\\s,(/])(Deore[\\s-]?XT(?: Di2)?|DeoreXT|(?<=Shimano )XT(?: Di2)?|XT(?= Di2| váltó)|Deore|SLX|Tourney|Altus|ALTUS|Acera|ACERA|Alivio|ALIVIO|Cues|CUES|Claris|Sora|Tiagra|GRX|(?<=Shimano )105)(?=$|[\\s,/.])",
              "group": 1
            }
          ]
        }
      ]
    }
  },
  "mapping": {
    "externalId": {
      "field": "sku"
    },
    "brand": [
      {
        "field": "manufacturer"
      },
      {
        "field": "name",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "^(\\S+)",
            "group": 1
          }
        ]
      }
    ],
    "name": {
      "field": "name"
    },
    "url": {
      "field": "product_url"
    },
    "price": {
      "field": "price"
    },
    "currency": {
      "pipeline": [
        {
          "op": "literal",
          "value": "HUF"
        }
      ]
    },
    "availability": {
      "field": "SzállításiIdő",
      "pipeline": [
        {
          "op": "mapValue",
          "cases": {
            "NO": "out_of_stock"
          },
          "default": "in_stock"
        }
      ]
    },
    "imageUrl": {
      "field": "image_url"
    },
    "description": {
      "field": "description"
    },
    "categoryLabel": [
      {
        "field": "category",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "^(?!Kerékpárok(?: >|$))(.+)$",
            "group": 1
          }
        ]
      },
      {
        "field": "sku",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "^(0200)\\d{8}$",
            "group": 1
          },
          {
            "op": "mapValue",
            "cases": {
              "0200": "Pedelec kerékpárok"
            }
          }
        ]
      },
      {
        "field": "sku",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "^(01)(?!1[134])\\d{10}$",
            "group": 1
          },
          {
            "op": "mapValue",
            "cases": {
              "01": "Kerékpárok"
            }
          }
        ]
      }
    ],
    "gtin": {
      "field": "gtin"
    },
    "mpn": {
      "field": "manufacturer_partnumber",
      "pipeline": [
        {
          "op": "regexCapture",
          "pattern": "^(\\d{9,10}|[Nn][Ee]\\d{10}|\\d{8}[A-Z][A-Z0-9]{1,2}|\\d{6}(?:-\\d{3})?)$",
          "group": 1
        }
      ]
    }
  },
  "postProcess": {
    "identityDescription": {
      "mode": "evidence"
    }
  }
}
