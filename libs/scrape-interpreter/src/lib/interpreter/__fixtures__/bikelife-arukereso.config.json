          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "(?:^|[\\s,(/-])(összteleszkópos(?= MTB)|[Ff]ully(?= MTB))",
              "group": 1
            }
          ]
        },
        {
          "label": "Váltó széria (cím)",
          "field": "name",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "(?:^|[\\s,(/])(Deore[\\s-]?XT(?: Di2)?|DeoreXT|(?<=Shimano )XT(?: Di2)?|XT(?= Di2| váltó)|Deore|SLX|Tourney|Altus|ALTUS|Acera|ACERA|Alivio|ALIVIO|Cues|CUES|Claris|Sora|Tiagra|GRX|(?<=Shimano )105)(?=$|[\\s,/.])",
              "group": 1
            }
          ]
        },
        {
          "label": "Akkumulátor kapacitása (cím)",
          "field": "name",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "(?:^|[\\s,(/])(\\d{3,4})\\s?(?:Wh|WH)(?![a-zA-Z])",
              "group": 1
            }
          ]
        },
        {
          "label": "Nyomaték (cím)",
          "field": "name",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "(?:^|[\\s,(/])(\\d{2,3})\\s?(?:Nm|NM)(?![a-zA-Z])",
              "group": 1
            }
          ]
        },
        {
          "label": "Motor (cím)",
          "field": "name",
          "pipeline": [
            {
              "op": "regexCapture",
              "pattern": "(?:^|[\\s,(/])(Bosch|BOSCH|Panasonic|Panasonis|Yamaha|Brose|Bafang|Fazua|XOFO|Xofo|MXUS|Shimano(?= Steps| EP\\d| E\\d{4}|\\s?\\d{2,3}\\s?Nm| motor| meghajt)|Steps(?= meghajt| motor|\\s?\\d{2,3}\\s?Nm))",
              "group": 1
            }
          ]
        }
      ]
