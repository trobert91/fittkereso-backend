{
  "baseUrl": "https://ebikeshop.hu",
  "maxItems": 100,
  "startUrls": [
    "https://ebikeshop.hu/termekek/elektromos-kerekparok?rendezes=nev_szerint_novekvo"
  ],
  "categories": {
    "ebikes": {
      "enabled": true,
      "sourceTitle": "Elektromos kerékpárok"
    }
  },
  "listPage": {
    "categoryName": [
      {
        "op": "parseJsonAttr",
        "selector": "#app",
        "attr": "data-page",
        "path": "props.meta.h1Title"
      }
    ],
    "pagination": {
      "urlTemplate": "{{startUrl}}&oldal={{page}}",
      "pageCount": [
        {
          "op": "parseJsonAttr",
          "selector": "#app",
          "attr": "data-page",
          "path": "props.lastPage"
        }
      ]
    },
    "items": [
      {
        "op": "parseJsonAttr",
        "selector": "#app",
        "attr": "data-page",
        "path": "props.products",
        "as": "products"
      },
      {
        "op": "filterJsonArray",
        "on": "products",
        "path": "isUsed",
        "equals": false
      }
    ],
    "itemMode": "json",
    "itemPipeline": [
      {
        "op": "assembleListProduct",
        "url": [
          {
            "op": "jsonPath",
            "path": "showPageUrl"
          }
        ],
        "externalId": [
          {
            "op": "jsonPath",
            "path": "productCode"
          }
        ],
        "name": [
          {
            "op": "jsonPath",
            "path": "productName"
          }
        ],
        "price": [
          {
            "op": "jsonPath",
            "on": "item",
            "path": "prices.sale",
            "cast": "boolean",
            "as": "onSale"
          },
          {
            "op": "branch",
            "condition": {
              "equals": {
                "value": "onSale",
                "to": true
              }
            },
            "ifTrue": [
              {
                "op": "jsonPath",
                "on": "item",
                "path": "prices.priceSale",
                "cast": "number"
              }
            ],
            "ifFalse": [
              {
                "op": "jsonPath",
                "on": "item",
                "path": "prices.price",
                "cast": "number"
              }
            ]
          },
          {
            "op": "round"
          }
        ],
        "priceWithoutDiscount": [
          {
            "op": "jsonPath",
            "on": "item",
            "path": "prices.sale",
            "cast": "boolean",
            "as": "onSale"
          },
          {
            "op": "branch",
            "condition": {
              "equals": {
                "value": "onSale",
                "to": true
              }
            },
            "ifTrue": [
              {
                "op": "jsonPath",
                "on": "item",
                "path": "prices.price",
                "cast": "number"
              },
              {
                "op": "round"
              }
            ],
            "ifFalse": []
          }
        ],
        "currency": [
          {
            "op": "literal",
            "value": "HUF"
          }
        ],
        "availability": [
          {
            "op": "jsonPath",
            "on": "item",
            "path": "preorderTypeTitle"
          },
          {
            "op": "mapValue",
            "cases": {
              "Készleten": "in_stock",
              "Gyártói készlet": "preorder",
              "Várható gyártás": "preorder",
              "Gyártói tervezet": "preorder"
            }
          }
        ]
      }
    ]
  },
  "detailPage": {
    "rawSpecs": [
      {
        "op": "parseJsonAttr",
        "selector": "#app",
        "attr": "data-page",
        "path": "props.product.properties",
        "as": "propsArray"
      },
      {
        "op": "mapJsonArray",
        "on": "propsArray",
        "fields": {
          "name": {
            "path": "categoryTitle"
          },
          "values": {
            "path": "value",
            "template": "{{value}} {{quantityUnit}}",
            "asArray": true
          }
        }
      }
    ],
    "description": [
      {
        "op": "parseJsonAttr",
        "selector": "#app",
        "attr": "data-page",
        "path": "props.product.longDesc"
      },
      {
        "op": "stripPattern",
        "pattern": "^\\s*(<h3[^>]*>\\s*A gyártóról:?\\s*</h3>\\s*<p[^>]*>[\\s\\S]*?</p>|<p[^>]*>\\s*A gyártóról:[\\s\\S]*?</p>)\\s*"
      },
      {
        "op": "stripPattern",
        "pattern": "\\s*<h3[^>]*>\\s*Általános[^<]*</h3>[\\s\\S]*$"
      },
      {
        "op": "regexCapture",
        "pattern": "\\S[\\s\\S]*",
        "group": 0
      }
    ],
    "category": {
      "breadcrumbOrSource": [
        {
          "op": "parseJsonAttr",
          "selector": "#app",
          "attr": "data-page",
          "path": "props.product.category.slug"
        }
      ],
      "slugLookup": [
        {
          "when": {
            "equalsIgnoreCase": "elektromos-kerekparok"
          },
          "slug": "ebikes"
        }
      ]
    },
    "brand": [
      {
        "op": "parseJsonAttr",
        "selector": "#app",
        "attr": "data-page",
        "path": "props.product.manufacturer.title",
        "as": "manufacturerTitle"
      },
      {
        "op": "parseJsonAttr",
        "selector": "#app",
        "attr": "data-page",
        "path": "props.product.legalManufacturerName",
        "as": "legalManufacturerRaw"
      },
      {
        "op": "stripPattern",
        "value": "legalManufacturerRaw",
        "pattern": "\\s*(GmbH|AG|Kft\\.?|Inc\\.?|Ltd\\.?|Zrt\\.?|Co\\.,? Ltd\\.?|S\\.p\\.A\\.?|B\\.V\\.?)\\s*$",
        "flags": "i",
        "trim": true,
        "as": "legalManufacturerClean"
      },
      {
        "op": "coalesce",
        "candidates": [
          "manufacturerTitle",
          "legalManufacturerClean"
        ]
      }
    ],
    "externalId": [
      {
        "op": "parseJsonAttr",
        "selector": "#app",
        "attr": "data-page",
        "path": "props.product.productCode"
      }
    ],
    "siblingIds": [
      {
        "op": "parseJsonAttr",
        "selector": "#app",
        "attr": "data-page",
        "path": "props.product.variations"
      },
      {
        "op": "filterJsonArray",
        "path": "type",
        "equals": "frame_size"
      },
      {
        "op": "flattenJsonArray",
        "path": "items"
      },
      {
        "op": "mapJsonArray",
        "fields": {
          "productCode": {
            "path": "productCode"
          }
        },
        "flattenField": "productCode"
      }
    ],
    "model": [
      {
        "op": "parseJsonAttr",
        "selector": "#app",
        "attr": "data-page",
        "path": "props.product.name",
        "as": "fullName"
      },
      {
        "op": "stripPattern",
        "value": "fullName",
        "pattern": "\\s*\\([^)]*\\)\\s*$",
        "as": "nameWithoutExtras"
      },
      {
        "op": "stripPattern",
        "value": "nameWithoutExtras",
        "pattern": "\\s*elektromos kerékpár\\s*$",
        "flags": "i",
        "trim": true,
        "as": "nameWithoutSuffix"
      },
      {
        "op": "stripPrefix",
        "value": "nameWithoutSuffix",
        "prefix": "{{brand}}",
        "flags": "i"
      }
    ],
    "releaseYear": [
      {
        "op": "mapSpecValue",
        "label": "Modellév",
        "single": true
      },
      {
        "op": "regexCapture",
        "pattern": "(\\d{2})\\s*$",
        "group": 1
      },
      {
        "op": "prependPrefix",
        "prefix": "20"
      },
      {
        "op": "regexCapture",
        "pattern": "\\d{4}",
        "group": 0,
        "cast": "number"
      }
    ],
    "images": [
      {
        "op": "parseJsonAttr",
        "selector": "#app",
        "attr": "data-page",
        "path": "props.product.images"
      },
      {
        "op": "filterJsonArray",
        "path": "type",
        "equals": "gallery"
      },
      {
        "op": "flattenJsonArray",
        "path": "images"
      },
      {
        "op": "filterJsonArray",
        "path": "code",
        "equals": "original"
      },
      {
        "op": "mapJsonArray",
        "fields": {
          "url": {
            "path": "url"
          }
        },
        "flattenField": "url"
      }
    ],
    "specMapping": {
      "ebikes": {
        "mappings": [
          {
            "key": "gender",
            "labels": [
              "Váztípus"
            ],
            "valueMap": {
              "Cross női": "Női"
            }
          },
          {
            "key": "frameType",
            "labels": [
              "Váztípus"
            ]
          },
          {
            "key": "frameSize",
            "labels": [
              "Vázméret"
            ],
            "extract": "number"
          },
          {
            "key": "usageType",
            "labels": [
              "Felhasználás módja"
            ],
            "valueMap": {
              "Cross": "Cross Trekking",
              "Városi": "City"
            }
          },
          {
            "key": "condition",
            "labels": [
              "Állapot"
            ]
          },
          {
            "key": "batteryPosition",
            "labels": [
              "Akku elhelyezkedése"
            ]
          },
          {
            "key": "wheelSize",
            "labels": [
              "Kerékméret"
            ],
            "replacePatterns": [
              {
                "from": ",",
                "to": "."
              }
            ],
            "extract": "number"
          },
          {
            "key": "drivetrain",
            "labels": [
              "Erőátvitel"
            ]
          },
          {
            "key": "suspension",
            "labels": [
              "Rugózás"
            ]
          },
          {
            "key": "brakeType",
            "labels": [
              "Fékfajta"
            ]
          },
          {
            "key": "brakeModel",
            "labels": [
              "Féktípus"
            ]
          },
          {
            "key": "gearType",
            "labels": [
              "Váltó típusa"
            ]
          },
          {
            "key": "gearCount",
            "labels": [
              "Váltó sebességfokozatainak száma"
            ],
            "extract": "number"
          },
          {
            "key": "shiftingActuation",
            "labels": [
              "Váltó működése"
            ]
          },
          {
            "key": "rearDerailleur",
            "labels": [
              "Váltó"
            ]
          },
          {
            "key": "batteryCapacity",
            "labels": [
              "Akku kapacitás"
            ],
            "extract": "number"
          },
          {
            "key": "torque",
            "labels": [
              "Nyomaték"
            ],
            "extract": "number"
          },
          {
            "key": "motorBrand",
            "labels": [
              "Motor gyártója"
            ]
          },
          {
            "key": "motorModel",
            "labels": [
              "Motor típusa"
            ]
          },
          {
            "key": "topSpeed",
            "labels": [
              "Maximális rásegítés"
            ],
            "extract": "number"
          },
          {
            "key": "pedelecClass",
            "labels": [
              "Maximális rásegítés"
            ],
            "valueMap": {
              "25 km/h": "Pedelec",
              "45 km/h": "S-Pedelec"
            }
          },
          {
            "key": "displayModel",
            "labels": [
              "Kijelző típus"
            ]
          }
        ]
      }
    },
    "offers": {
      "offerList": [
        {
          "op": "selectAll",
          "selector": "script"
        },
        {
          "op": "findScriptContaining",
          "contains": "\"@type\":\"Offer\""
        },
        {
          "op": "wrapInArray"
        }
      ],
      "itemMode": "json",
      "itemPipeline": [
        {
          "op": "assembleOffer",
          "price": [
            {
              "op": "parseJsonAttr",
              "selector": "#app",
              "attr": "data-page",
              "path": "props.product.prices.sale",
              "as": "onSale"
            },
            {
              "op": "branch",
              "condition": {
                "equals": {
                  "value": "onSale",
                  "to": true
                }
              },
              "ifTrue": [
                {
                  "op": "parseJsonAttr",
                  "selector": "#app",
                  "attr": "data-page",
                  "path": "props.product.prices.priceSale"
                }
              ],
              "ifFalse": [
                {
                  "op": "parseJsonAttr",
                  "selector": "#app",
                  "attr": "data-page",
                  "path": "props.product.prices.price"
                }
              ]
            },
            {
              "op": "round"
            }
          ],
          "priceWithoutDiscount": [
            {
              "op": "parseJsonAttr",
              "selector": "#app",
              "attr": "data-page",
              "path": "props.product.prices.sale",
              "as": "onSaleForOriginalPrice"
            },
            {
              "op": "branch",
              "condition": {
                "equals": {
                  "value": "onSaleForOriginalPrice",
                  "to": true
                }
              },
              "ifTrue": [
                {
                  "op": "parseJsonAttr",
                  "selector": "#app",
                  "attr": "data-page",
                  "path": "props.product.prices.price"
                },
                {
                  "op": "round"
                }
              ],
              "ifFalse": [
                {
                  "op": "parseJsonAttr",
                  "selector": "#app",
                  "attr": "data-page",
                  "path": "props.product.prices.__notPresent"
                }
              ]
            }
          ],
          "currency": [
            {
              "op": "literal",
              "value": "HUF"
            }
          ],
          "availability": [
            {
              "op": "regexCapture",
              "pattern": "\"availability\":\"https://schema\\.org/(\\w+)\"",
              "group": 1
            },
            {
              "op": "mapValue",
              "cases": {
                "InStock": "in_stock",
                "PreOrder": "preorder",
                "LimitedAvailability": "in_stock",
                "OutOfStock": "out_of_stock",
                "SoldOut": "out_of_stock"
              },
              "default": "unknown"
            }
          ],
          "url": [
            {
              "op": "buildBaseUrl",
              "from": "task.url"
            }
          ],
          "externalId": [
            {
              "op": "parseJsonAttr",
              "selector": "#app",
              "attr": "data-page",
              "path": "props.product.productCode"
            }
          ],
          "gtin": [
            {
              "op": "parseJsonAttr",
              "selector": "#app",
              "attr": "data-page",
              "path": "props.product.gtin"
            }
          ],
          "mpn": [
            {
              "op": "parseJsonAttr",
              "selector": "#app",
              "attr": "data-page",
              "path": "props.product.productCode"
            }
          ],
          "locations": [
            {
              "op": "parseJsonAttr",
              "selector": "#app",
              "attr": "data-page",
              "path": "props.product.locations"
            }
          ]
        }
      ]
    },
    "translation": {
      "enabled": false,
      "sourceLanguage": "hu",
      "targetLanguage": "en",
      "contextTemplate": "Technical specification values from an ebikeshop.hu electric bicycle product listing. Preserve units, model numbers, and technical jargon."
    }
  }
}
