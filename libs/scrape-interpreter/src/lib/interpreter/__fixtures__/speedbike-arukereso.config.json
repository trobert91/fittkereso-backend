{
  "baseUrl": "https://speedbike.hu",
  "maxItems": 10,
  "feedUrl": "https://speedbike.hu/api/?route=export/feed&id=arukereso",
  "format": "auto",
  "categories": {
    "ebikes": {
      "enabled": true,
      "sourceTitle": "E-BIKE"
    }
  },
  "category": {
    "labelFrom": [
      {
        "op": "splitAndTake",
        "separator": " > ",
        "index": 1,
        "trim": true
      }
    ],
    "slugLookup": [
      {
        "when": {
          "equalsIgnoreCase": "E-BIKE"
        },
        "slug": "ebikes"
      }
    ]
  },
  "identityExtraction": {
    "specRows": [
      "Váz",
      "Frame",
      "Villa",
      "Fork",
      "Lengéscsillapító",
      "Dampener",
      "Motor",
      "E-System",
      "Operating System",
      "Akkumulátor",
      "Battery",
      "Kerék",
      "Kerékméret",
      "Max kerék méret",
      "Első kerék",
      "Hátsó kerék",
      "Felnik",
      "Gumi",
      "Külsők",
      "Tire",
      "Első gumi",
      "Hátsó gumi",
      "Gumiabroncs",
      "Gumiabroncsok",
      "Első gumiabroncs",
      "Hátsó gumiabroncs",
      "Gumiköpeny",
      "Első gumiköpeny",
      "Hátsó gumiköpeny",
      "Hátsó váltó",
      "Fogaskoszorú",
      "Cassette",
      "Váltó",
      "Váltókar",
      "Váltókarok",
      "Shifters",
      "Gear Shift",
      "Váltórendszer",
      "Súly",
      "Weight",
      "Modellév",
      "Model Year",
      "Évjárat"
    ]
  },
  "mapping": {
    "externalId": {
      "field": "identifier"
    },
    "brand": {
      "field": "manufacturer"
    },
    "name": {
      "field": "name"
    },
    "url": {
      "field": "product_url"
    },
    "price": {
      "field": "price"
    },
    "availability": {
      "field": "delivery_time",
      "pipeline": [
        {
          "op": "mapValue",
          "cases": {
            "NO": "out_of_stock"
          },
          "default": "in_stock"
        }
      ]
    },
    "imageUrl": {
      "field": "image_url"
    },
    "description": {
      "field": "description"
    },
    "categoryLabel": {
      "field": "category"
    },
    "currency": {
      "pipeline": [
        {
          "op": "literal",
          "value": "HUF"
        }
      ]
    },
    "gtin": {
      "field": "ean_code"
    },
    "mpn": {
      "field": "sku",
      "pipeline": [
        {
          "op": "stripPattern",
          "pattern": "^MX"
        }
      ]
    }
  },
  "specMapping": {
    "ebikes": {
      "mappings": [
        {
          "key": "modelYear",
          "labels": [
            "Modellév",
            "Model Year",
            "Évjárat"
          ],
          "extract": "number"
        },
        {
          "key": "frameType",
          "labels": [
            "Váztípus"
          ]
        },
        {
          "key": "gender",
