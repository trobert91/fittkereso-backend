{
  "baseUrl": "https://www.mangobike.hu",
  "feedUrl": "https://www.mangobike.hu/xml/arukereso.xml",
  "format": "auto",
  "categories": {
    "ebikes": {
      "enabled": true,
      "rules": [
        {
          "when": {
            "equalsIgnoreCase": "Elektromos Kerékpárok"
          }
        },
        {
          "when": [
            {
              "equalsIgnoreCase": "Kerékpárok"
            },
            {
              "titleMatches": "\\bElektromos\\b"
            }
          ]
        }
      ],
      "extraSpecRows": [
        {
          "label": "Webshop kategória",
          "field": "category",
          "pipeline": [
            {
              "op": "stripPattern",
              "pattern": "^[^>]*start_nav[^>]*>\\s*"
            }
          ]
        }
      ]
    },
    "bikes": {
      "enabled": true,
      "rules": [
        {
          "when": {
            "equalsIgnoreCase": "Kerékpárok"
          },
          "unless": {
            "titleMatches": "\\bElektromos\\b"
          }
        }
      ],
      "extraSpecRows": [
        {
          "label": "Webshop kategória",
          "field": "category",
          "pipeline": [
            {
              "op": "stripPattern",
              "pattern": "^[^>]*start_nav[^>]*>\\s*"
            }
          ]
        }
      ]
    }
  },
  "category": {
    "labelFrom": [
      {
        "op": "stripPattern",
        "pattern": "^[^>]*start_nav[^>]*>\\s*"
      },
      {
        "op": "splitAndTake",
        "separator": " > ",
        "index": 0,
        "trim": true
      }
    ]
  },
  "mapping": {
    "externalId": {
      "field": "identifier"
    },
    "brand": {
      "field": "manufacturer"
    },
    "name": {
      "field": "name"
    },
    "url": {
      "field": "product_url"
    },
    "price": {
      "field": "price"
    },
    "currency": {
      "pipeline": [
        {
          "op": "literal",
          "value": "HUF"
        }
      ]
    },
    "availability": {
      "field": "delivery_time",
      "pipeline": [
        {
          "op": "mapValue",
          "cases": {
            "NO": "out_of_stock"
          },
          "default": "in_stock"
        }
      ]
    },
    "imageUrl": {
      "field": "image_url",
      "pipeline": [
        {
          "op": "stripPattern",
          "pattern": "^.*/img/default-placeholder\\.png$"
        }
      ]
    },
    "description": {
      "field": "description"
    },
    "categoryLabel": [
      {
        "field": "name",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "\\b([Tt]rike)\\b",
            "group": 1
          }
        ]
      },
      {
        "field": "category"
      }
    ],
    "mpn": [
      {
        "field": "image_url",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "/catalog/KT-([12]\\d{9}|0\\d{8})/",
            "group": 1
          }
        ]
      },
      {
        "field": "image_url",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "/catalog/VB-(\\d{6,7}-(?:\\d{2}|XX?S|S|M|L|XX?L))(?:cm|[TE])?/",
            "group": 1
          }
        ]
      },
      {
        "field": "image_url",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "/catalog/BF-(\\d{7})/",
            "group": 1
          }
        ]
      },
      {
        "field": "image_url",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "/catalog/CS-(\\d{8}[A-Z][A-Z0-9]{1,2})/",
            "group": 1
          }
        ]
      },
      {
        "field": "image_url",
        "pipeline": [
          {
            "op": "regexCapture",
            "pattern": "/catalog/KR-(KR[A-Z0-9]{14,18})/",
            "group": 1
          }
        ]
      }
    ]
  }
}
