  },
  "category": {
    "labelFrom": [
      {
        "op": "regexCapture",
        "pattern": "^(Kerékpár > Elektromos kerékpárok|Kerékpár)(?: > |$)",
        "group": 1
      }
    ]
  },
  "mapping": {
    "externalId": {
      "field": "id"
    },
    "url": {
      "field": "link"
    },
    "name": {
      "field": "title"
    },
    "brand": {
      "field": "brand"
    },
    "gtin": {
      "field": "gtin",
      "pipeline": [
        {
          "op": "stripPattern",
          "pattern": "^20\\d{2}$"
        }
      ]
    },
    "mpn": {
      "field": "mpn"
    },
    "releaseYear": {
      "field": "title",
      "pipeline": [
        {
          "op": "regexCapture",
          "pattern": "\\b(20[2-3]\\d)\\b",
          "group": 1
        }
      ]
    },
    "imageUrl": {
      "field": "image_link"
    },
    "categoryLabel": {
      "field": "product_type"
    },
    "description": {
      "field": "description"
    },
    "availability": {
      "field": "availability"
    },
    "condition": {
      "field": "condition"
    },
    "currency": {
      "pipeline": [
        {
          "op": "literal",
          "value": "HUF"
        }
      ]
    },
    "price": [
      {
        "field": "sale_price",
        "pipeline": [
          {
            "op": "stripPattern",
            "pattern": "\\s*[A-Z]{3}$"
          }
        ]
      },
      {
        "field": "price",
        "pipeline": [
          {
            "op": "stripPattern",
            "pattern": "\\s*[A-Z]{3}$"
          }
        ]
      }
    ],
    "priceWithoutDiscount": {
      "field": "price",
      "pipeline": [
        {
          "op": "stripPattern",
          "pattern": "\\s*[A-Z]{3}$"
        }
      ]
    }
  },
  "postProcess": {
    "identityDescription": {
      "mode": "evidence"
    }
  }
}
