            "valuePatterns": [
              { "pattern": "carbon|karbon|composite|uhlík|\\bC:6\\d", "value": "Karbon" },
              { "pattern": "titan", "value": "Titán" },
              { "pattern": "\\balu|\\balloy|alumín|alimín|hliník|\\b(?:al-?)?(?:6061|6066|6069|6013|7005|7020|7075)\\b", "value": "Alumínium" },
              { "pattern": "hi-?ten|steel|acél|\\bocel|cr-?mo|chromoly", "value": "Acél" }
            ]
          },
          {
            "key": "usageType",
            "labels": ["Webshop kategória"],
            "valuePatterns": [
              { "pattern": "összteleszkópos mtb", "value": "Összteleszkópos MTB" },
              { "pattern": "merevfarú mtb", "value": "MTB" },
              { "pattern": "> gyerek", "value": "Gyerek" },
              { "pattern": "> cross trekking", "value": "Cross Trekking" },
              { "pattern": "> trekking", "value": "Trekking" },
              { "pattern": "> gravel", "value": "Gravel" },
              { "pattern": "> országúti", "value": "Országúti" },
              { "pattern": "> triatlon", "value": "Országúti" },
              { "pattern": "> cyclocross", "value": "Cyclocross" },
              { "pattern": "> fitness", "value": "Fitness" },
              { "pattern": "> városi", "value": "City" }
            ]
          },
          {
            "key": "usageType",
            "labels": ["Típus (cím)"],
            "valuePatterns": [
              { "pattern": "^FS$", "value": "Összteleszkópos MTB" },
              { "pattern": "^Dirt$", "value": "Dirt" },
              { "pattern": "^cross trekking$", "value": "Cross Trekking" },
              { "pattern": "^trekking$", "value": "Trekking" },
              { "pattern": "^városi$", "value": "City" },
              { "pattern": "^fitness$", "value": "Fitness" },
              { "pattern": "^gravel$", "value": "Gravel" },
              { "pattern": "^országúti$", "value": "Országúti" },
              { "pattern": "^triatlon$", "value": "Országúti" },
              { "pattern": "^cyclocross$", "value": "Cyclocross" },
              { "pattern": "^gyerek$", "value": "Gyerek" }
            ]
          },
          {
            "key": "gender",
            "labels": ["Webshop kategória"],
            "valuePatterns": [
              { "pattern": "> gyerek", "value": "Gyermek" }
            ]
          },
          {
            "key": "gender",
            "labels": ["Nem"],
            "valuePatterns": [
              { "pattern": "^férfi$", "value": "Férfi" },
              { "pattern": "^női$", "value": "Női" },
              { "pattern": "^gyerek$|^gyermek$", "value": "Gyermek" }
            ]
          },
          {
            "key": "gearCount",
            "labels": ["Sebességek (leírás)"],
            "extract": "multiply"
          },
          {
            "key": "gearCount",
            "labels": ["Sebességek (cím)"],
            "extract": "multiply"
          },
          {
            "key": "chainringCount",
            "labels": ["Sebességek (leírás)"],
            "extract": "regexpList",
            "extractPatterns": ["^(\\d) ?[x×]"]
          },
          {
            "key": "chainringCount",
            "labels": ["Sebességek (cím)"],
            "extract": "regexpList",
            "extractPatterns": ["^(\\d) ?[x×]"]
          },
          {
            "key": "weight",
            "labels": ["Tömeg (leírás)"],
            "extract": "number"
          }
        ]
      }
    }
  },
  "mapping": {
    "externalId": {
      "field": "id"
    },
    "url": {
      "field": "link"
    },
    "name": {
      "field": "title"
    },
    "brand": {
      "field": "brand"
    },
    "gtin": {
      "field": "gtin"
    },
    "mpn": {
      "field": "mpn"
    },
    "imageUrl": {
      "field": "image_link"
    },
    "description": {
      "field": "description"
    },
    "categoryLabel": [
      {
        "field": "product_type",
        "pipeline": [{ "op": "regexCapture", "pattern": "^KERÉKPÁR > (Használt) kerékpár", "group": 1 }]
      },
      {
        "field": "product_type",
        "pipeline": [{ "op": "regexCapture", "pattern": "^(E-BIKE|KERÉKPÁR) > ", "group": 1 }]
      },
      {
        "field": "product_type",
        "pipeline": [{ "op": "regexCapture", "pattern": "^(?!AKCIÓINK > |arukereso > )([^>]+?)(?: > |$)", "group": 1 }]
      },
      { "field": "custom_label_0", "pipeline": [{ "op": "regexCapture", "pattern": "^(E-BIKE)$", "group": 1 }] },
      { "field": "custom_label_1", "pipeline": [{ "op": "regexCapture", "pattern": "^(E-BIKE)$", "group": 1 }] },
      { "field": "custom_label_2", "pipeline": [{ "op": "regexCapture", "pattern": "^(E-BIKE)$", "group": 1 }] },
      { "field": "custom_label_3", "pipeline": [{ "op": "regexCapture", "pattern": "^(E-BIKE)$", "group": 1 }] },
      { "field": "custom_label_4", "pipeline": [{ "op": "regexCapture", "pattern": "^(E-BIKE)$", "group": 1 }] },
      { "field": "custom_label_0", "pipeline": [{ "op": "regexCapture", "pattern": "^(KERÉKPÁR)$", "group": 1 }] },
      { "field": "custom_label_1", "pipeline": [{ "op": "regexCapture", "pattern": "^(KERÉKPÁR)$", "group": 1 }] },
      { "field": "custom_label_2", "pipeline": [{ "op": "regexCapture", "pattern": "^(KERÉKPÁR)$", "group": 1 }] },
      { "field": "custom_label_3", "pipeline": [{ "op": "regexCapture", "pattern": "^(KERÉKPÁR)$", "group": 1 }] },
      { "field": "custom_label_4", "pipeline": [{ "op": "regexCapture", "pattern": "^(KERÉKPÁR)$", "group": 1 }] }
    ],
    "currency": {
      "pipeline": [
        {
          "op": "literal",
          "value": "HUF"
        }
      ]
    },
    "price": [
      {
        "field": "sale_price",
        "pipeline": [
          {
            "op": "stripPattern",
            "pattern": "\\s*[A-Z]{3}$"
          }
        ]
      },
      {
        "field": "price",
        "pipeline": [
          {
            "op": "stripPattern",
            "pattern": "\\s*[A-Z]{3}$"
          }
        ]
      }
    ],
    "priceWithoutDiscount": {
      "field": "price",
      "pipeline": [
        {
          "op": "stripPattern",
          "pattern": "\\s*[A-Z]{3}$"
        }
      ]
    },
    "availability": {
      "field": "availability"
    },
    "condition": {
      "field": "condition"
    }
  }
}
