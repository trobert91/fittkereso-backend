{
  "embeddingSimilarityThreshold": 0.4,
  "embeddingResultLimit": 5,
  "webSearchRelevanceGate": 70,
  "minScoreToRecord": 60,
  "review": {
    "cleanupEnabled": true,
    "supersededRetentionDays": 60,
    "doneRetentionDays": 60
  },
  "priority": {
    "recomputeEnabled": true,
    "recomputeBatchSize": 500,
    "maxRowsPerRun": 50000,
    "weights": {
      "confidence": {
        "outcomeAgreement": 0.3,
        "specAgreement": 0.21,
        "gateAgreement": 0.17,
        "corroboration": 0.15,
        "margin": 0.085,
        "selfReport": 0.085
      },
      "impact": {
        "blastRadius": 0.5,
        "actionKind": 0.3,
        "mergeReach": 0.2
      }
    }
  },
  "matching": {
    "acceptThreshold": 70,
    "acceptThresholdStrict": 80,
    "ambiguityGap": 5,
    "maxLlmPicks": 6,
    "defaultStrictness": "moderate",
    "defaultNumericTokenWeight": 2.5,
    "importantTokenWeightThreshold": 2.0,
    "llmDecisionFloor": 50
  },
  "search": {
    "maxModelVariants": 20,
    "maxCandidates": 50,
    "decisionModel": "deepseek-v4-flash",
    "webSearch": {
      "extractionModel": "deepseek-v4-flash",
      "minProductConfidence": 0.5,
      "minVariantConfidence": 0.6
    },
    "crossMarket": {
      "topCandidates": 5,
      "minCandidateConfidence": 0.6,
      "minMatchConfidence": 0.7
    }
  }
}