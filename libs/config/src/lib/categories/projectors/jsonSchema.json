{
  "type": "object",
  "title": "Projector",
  "properties": {
    "projectorType": {
      "meta": {
        "order": 0,
        "examples": [
          "DLP",
          "LCD",
          "LED",
          "LCoS",
          "3LCD"
        ]
      },
      "type": "string",
      "title": "Projector type"
    },
    "resolution": {
      "meta": {
        "order": 1,
        "examples": [
          "3840x2160",
          "1920x1080",
          "2560x1440"
        ]
      },
      "type": "string",
      "title": "Resolution"
    },
    "brightness": {
      "meta": {
        "unit": "lumens",
        "order": 2,
        "examples": [
          "2300",
          "3000",
          "4000"
        ]
      },
      "type": "number",
      "title": "Brightness"
    },
    "contrastRatio": {
      "meta": {
        "order": 3,
        "examples": [
          "2000:1",
          "40000:1"
        ]
      },
