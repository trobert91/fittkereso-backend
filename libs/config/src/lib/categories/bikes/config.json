  "promptConfig": {
    "specExamples": {
      "identityComponentRow": "a \"Váltó\" row naming the gearing, a frame row stating the material or the suspension",
      "componentInference": "a Shimano or SRAM shifter/derailleur without Di2 or AXS is mechanical shiftingActuation while Di2/AXS is electronic, a Shimano Nexus or Alfine hub means gearType \"Agyváltó\", a single sprocket with no derailleur means gearType \"Egysebességes\", a coaster-brake hub (\"kontrafék\", \"kontrás\", coaster brake) puts the coaster brake into brakeType (\"Kontrafék\" alone, \"Racker + kontrafék\" or \"Tárcsa + kontrafék\" beside a rim or disc brake), and a spec table listing a rear shock means suspension \"Első teleszkóp, hátsó rugóstag\"",
      "componentRow": "a row named \"Váltó\" with value \"Shimano Deore RD-M5100 11-S\" may be the only place the number of gears appears; a \"Váz\"/frame row's free text may state the frame material or suspension",
      "descriptionStatement": "\"3 fokozatú Shimano Nexus agyváltó\" clearly states gearType \"Agyváltó\" and 3 gears",
      "noDerivation": "don't derive the number of gears from a groupset's name",
      "definedValues": "a \"Cross\" or \"City\" in it"
    }
  }
}
