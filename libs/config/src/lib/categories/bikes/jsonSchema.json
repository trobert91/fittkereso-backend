    "usageType": {
      "meta": {
        "order": 7,
        "valueDefinitions": {
          "Országúti": "A drop-bar bike for paved roads: race, endurance, aero, triathlon or time-trial (\"országúti\").",
          "Gravel": "A drop-bar bike for gravel and mixed surfaces, with tyres wider than a road bike's.",
          "Cyclocross": "A drop-bar bike built for cyclocross racing.",
          "MTB": "A mountain bike without rear suspension: flat bar, off-road tyres, a suspension or rigid fork (\"MTB\", \"hardtail\", \"hegyi\").",
          "Összteleszkópos MTB": "A mountain bike with front and rear suspension (\"fully\", \"összteleszkópos\", or a rear shock in the spec rows).",
          "Dirt": "A dirt-jump or pump-track hardtail: a small, strong frame, usually 24″ or 26″ wheels, one gear.",
          "BMX": "A BMX for park, street or BMX racing: 20″ wheels (16–24″ on race sizes), one gear.",
          "Trekking": "A touring bike for longer rides on roads and paths: 28″ wheels, usually fenders, a rack, lights and a kickstand (\"trekking\", \"túra\").",
          "Cross Trekking": "A hybrid for roads and light off-road: flat bar, 28″ or 29″ wheels, a suspension fork, tyres with some tread (\"cross\", \"crossbike\"; \"SUV\" e-bikes too).",
          "City": "An everyday town bike: upright position, often a step-through frame, fenders, a chain guard, hub gears or a basket (\"városi\").",
          "Fitness": "A light, fast flat-bar bike for paved roads, without touring equipment.",
          "Cruiser": "A cruiser: a wide swept-back bar, balloon tyres and a relaxed frame.",
          "Single speed / Fixi": "A street bike the input calls single-speed or fixed-gear. Not every bike with one gear.",
          "Összecsukható": "Folds for carrying or storage (\"összecsukható\", \"folding\"). It is Összecsukható whatever its riding type.",
          "Tandem": "For two riders, one behind the other. It is Tandem whatever its riding type.",
          "Fat": "Tyres about 4″ (100 mm) wide or wider (\"fatbike\"). It is Fat whatever its riding type.",
          "Cargo": "Built to carry loads or passengers: a front box or platform, a long-tail rear, or called a cargo bike (\"cargo\", \"teherkerékpár\"). It is Cargo whatever its riding type.",
          "Gyerek": "A bike made for children: the input calls it a children's or junior bike (\"gyerek\", \"gyermek\", \"junior\", \"kids\"), or gives a child's age or rider height. A children's bike is Gyerek, never its riding type: a kids' MTB, cross or gravel bike is Gyerek. Wheel size alone doesn't make a bike Gyerek.",
          "Futóbicikli": "A balance bike: no pedals and no drivetrain, for small children (\"futóbicikli\", \"futókerékpár\"). It is Futóbicikli, never Gyerek."
        }
      },
      "enum": [
