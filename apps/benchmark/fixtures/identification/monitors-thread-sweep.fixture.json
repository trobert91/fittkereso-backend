        {
          "externalId": "ds-op",
          "authorName": "DirectAsker",
          "body": "Anyone tried the Acer Predator X34 X5? Hard to find reviews.",
          "nodeType": "CONTEXT",
          "depth": 0
        },
        {
          "externalId": "ds-r1",
          "authorName": "AcerOwner",
          "body": "I've had the Acer Predator X34 X5 for two months. Color accuracy is excellent for SDR work, but I've noticed some HDR highlights clip in dark scenes. Response time is genuinely fast — no smearing in fast-paced shooters.",
          "parentExternalId": "ds-op",
          "nodeType": "PLAN",
          "depth": 1
        },
        {
          "externalId": "ds-r2",
          "authorName": "Skeptic",
          "body": "I'd skip it and get the ROG Swift PG34WCDM instead — better build quality and the warranty covers OLED burn-in for three years.",
          "parentExternalId": "ds-op",
          "nodeType": "PLAN",
          "depth": 1
        }
      ]
    },
    {
